# Dockhand: set these as stack variables, replacing the example NAS address.
# Shell: copy to .env and load it using docker compose --env-file .env ...
DRK_BIND_IP=192.168.178.20
DRK_PORT=8080
DRK_ORIGIN=http://192.168.178.20:8080
DRK_HTTP=true
# The Compose attachment in each GitHub release pins the release image already.
# DRK_IMAGE=ghcr.io/redzacmx3/drk:v0.1.0-rc.1
# Existing installation: set this to the ACTUAL existing data-volume name.
DRK_DATA_VOLUME=drk_release_inventory_data

# Nur nach Sicherung und gestopptem Stack einmalig fuer ein Schema-Upgrade:
# DRK_INIT_COMMAND=migrate
# Nach erfolgreichem Upgrade wieder auf init setzen.
