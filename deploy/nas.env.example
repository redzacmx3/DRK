# Copy to .env.nas; adapt these values. No secrets belong in this file.
# Browser origin: HTTPS, without trailing slash or path.
DRK_ORIGIN=https://inventar.example.de
# Tailscale IPv4 of the NAS itself. Never use 0.0.0.0 for this binding.
DRK_BIND_IP=100.64.1.2
DRK_HTTPS_PORT=8443
# Absolute directory on the Docker host/NAS; not inside Dockhand's own container.
DRK_TLS_DIR=/volume1/docker/drk/tls
